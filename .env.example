# ==============================================================================
# OpenRouter API Configuration
# ==============================================================================
# 1. OpenRouter API Key (bắt đầu bằng sk-or-v1-...)
# Lấy key tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# 2. OpenAI API Key (gán bằng key OpenRouter để tương thích với OpenAI SDK và RAGAS)
OPENAI_API_KEY=sk-or-v1-...

# 3. OpenRouter Base URL (OpenAI SDK và LangChain tự động gọi qua endpoint này)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_BASE=https://openrouter.ai/api/v1

# 4. Model sử dụng trên OpenRouter (OpenRouter yêu cầu format: provider/model-name)
# Gợi ý:
#   - openai/gpt-4o-mini          (khuyên dùng cho bài lab: chính xác, tiết kiệm chi phí)
#   - google/gemini-2.0-flash-001 (tốc độ cao, chi phí rất rẻ)
#   - meta-llama/llama-3.3-70b-instruct
LLM_MODEL=openai/gpt-4o-mini

# ==============================================================================
# Qdrant Vector Database
# ==============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
